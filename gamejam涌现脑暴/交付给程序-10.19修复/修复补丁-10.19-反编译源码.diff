+		private T FindComponent<T>(string name) where T : UnityEngine.Component
+		{
+			Transform[] componentsInChildren = transform.root.GetComponentsInChildren<Transform>(includeInactive: true);
+			for (int i = 0; i < componentsInChildren.Length; i++)
+			{
+				if (componentsInChildren[i].name == name)
+				{
+					return componentsInChildren[i].GetComponent<T>();
+				}
+			}
+			return null;
+		}
